{
  "permissions": {
    "allow": [
      "Bash(git clone *)",
      "Read(//tmp/**)",
      "Read(//tmp/scs-sdk-plugin/**)",
      "Bash(cargo check *)",
      "Bash(cargo build *)",
      "Bash(cargo publish *)",
      "Bash(cargo search *)",
      "Bash(mv scs-sdk-sys *)",
      "Bash(mv scs-shared-memory *)",
      "Bash(mv scs-client *)",
      "Bash(mkdir -p /tmp/scs_sdk)",
      "Bash(curl -sL -o scs_sdk_1_14.zip \"https://download.eurotrucksimulator2.com/scs_sdk_1_14.zip\")",
      "Bash(unzip -q scs_sdk_1_14.zip -d scs_sdk_1_14)",
      "Bash(awk '{print $2, $3}')",
      "Bash(unzip -l /tmp/scs_sdk/scs_sdk_1_14.zip)",
      "Bash(unzip -o /tmp/scs_sdk/scs_sdk_1_14.zip 'include/common/*' -d /tmp/scs_sdk/scs_sdk_1_14_reextract)",
      "Bash(awk '{n=$2; v=$3; for\\(i=4;i<=NF;i++\\) v=v\" \"$i; print n\"\\\\t\"v}')",
      "Bash(rustup target *)",
      "Bash(cargo test *)"
    ]
  }
